[Unit]
Description=Lanchat LAN messaging daemon
# The daemon is the network + transport worker (UDP discovery, TLS sockets,
# history). It has no GUI of its own, but the QML shell connects to its
# control socket only once a graphical session is up, and the socket lives in
# the per-user runtime dir that only exists during the session. Tie it to the
# graphical session so it comes up at login and dies at logout, exactly like
# the other omarchy services (and like the old shell-spawned daemon did).
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
# %h = the user's home dir (portable across machines). server.py --socket
# serves the unix-socket control channel that the QML bridge connects to.
ExecStart=/usr/bin/python3 %h/.config/omarchy/plugins/KelpME.lanchat/server.py --socket
# systemd supervises the daemon: always restart on crash/exit so lanchat is
# never silently dead (the whole reason for this unit).
Restart=always
RestartSec=2
# A tiny delay so a crash-loop doesn't hammer the CPU; also gives the socket
# path time to be cleaned up between restarts.
StartLimitIntervalSec=0

[Install]
WantedBy=graphical-session.target
